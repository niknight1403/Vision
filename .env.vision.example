# Public API origin only; no secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=https://api.example.invalid

# API + task worker (server-side only)
DATABASE_URL=postgresql://user:password@db:5432/autonomagent
AUTH_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-bytes
VISION_WORKER_URL=http://vision-worker:8091
VISION_WORKER_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Python Vision worker (private network only)
API_BASE_URL=http://api:8080
VISION_ALLOWED_IMAGE_HOSTS=images.example.com,cdn.example.com
LLM_API_KEY=replace-me
LLM_BASE_URL=http://ollama:11434/v1
VISION_MODEL=qwen2.5-vl:7b
VISION_WORKER_HOST=0.0.0.0
VISION_WORKER_PORT=8091
