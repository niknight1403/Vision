{
  "name": "autonomagent",
  "version": "0.4.0-vision-alpha",
  "private": true,
  "description": "Android-first controlled product arbitrage workspace",
  "workspaces": [
    "apps/mobile",
    "services/api",
    "packages/trading-core"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @autonomagent/mobile",
    "android": "npm run android --workspace @autonomagent/mobile",
    "test": "npm run test --workspaces --if-present",
    "test:python": "PYTHONPATH=services/vision-worker python3 -m pytest -q services/vision-worker/tests",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "audit:gate": "node scripts/audit-gate.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "effect": "3.22.1",
    "minimatch": "^11.0.1"
  }
}
