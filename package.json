{
  "name": "autonomagent",
  "version": "0.3.0",
  "private": true,
  "description": "Android-first controlled product arbitrage workspace",
  "workspaces": [
    "apps/mobile",
    "services/api",
    "packages/trading-core"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @autonomagent/mobile",
    "android": "npm run android --workspace @autonomagent/mobile",
    "prepare:checks": "npm exec --workspace @autonomagent/api -- prisma generate --schema prisma/schema.prisma",
    "pretest": "npm run prepare:checks",
    "test": "npm run test --workspaces --if-present",
    "pretypecheck": "npm run prepare:checks",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "audit:gate": "node scripts/audit-gate.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "effect": "3.22.1",
    "minimatch": "^11.0.1"
  }
}
