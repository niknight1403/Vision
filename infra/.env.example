# Copy to infra/.env and replace placeholders. Never commit real values.
POSTGRES_DB=autonomagent
POSTGRES_USER=autonomagent
POSTGRES_PASSWORD=replace-with-long-random-password
REDIS_PASSWORD=replace-with-long-random-password
VISION_WORKER_TOKEN=replace-with-at-least-32-random-characters
VISION_ALLOWED_IMAGE_HOSTS=images.example.com,cdn.example.com
LLM_API_KEY=ollama
VISION_MODEL=qwen2.5-vl:7b
# Optional cloud fallback; all three values are required to enable it.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# API authentication and local bind address
AUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters
API_BIND_ADDRESS=127.0.0.1

# One-time initial administrator bootstrap; use a unique password (16-128 bytes).
# Never commit the real password or put it in the Android app.
ADMIN_BOOTSTRAP_EMAIL=niko.oeben@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-secret-password
