{
  "name": "@autonomagent/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/services/api/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "worker": "tsx src/agent-task-worker.ts",
    "admin:bootstrap": "tsx src/admin-bootstrap.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@prisma/client": "^6.5.0",
    "fastify": "^5.2.1",
    "@autonomagent/trading-core": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12"
  }
}
