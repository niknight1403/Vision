{
  "name": "@autonomagent/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/services/api/src/server.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run src --exclude '**/*.integration.test.ts'",
    "test": "npm run test:unit",
    "test:db": "node scripts/require-postgres.mjs && vitest run 'src/**/*.integration.test.ts' --reporter=default --reporter=json --outputFile=/tmp/autonomagent-api-db-report.json && node scripts/verify-db-integration.mjs /tmp/autonomagent-api-db-report.json",
    "worker": "tsx src/agent-task-worker.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@prisma/client": "^6.5.0",
    "fastify": "^5.2.1",
    "@autonomagent/trading-core": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12"
  }
}
