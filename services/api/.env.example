HOST=0.0.0.0
PORT=8080
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
EMERGENCY_STOP=true
# PostgreSQL connection string; required for the auth, deal and wallet services and their integration tests.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomagent?schema=public
# HS256 access-token signing secret, at least 32 bytes. Generate a random value per environment.
# The auth routes stay closed with 503 AUTH_SIGNING_SECRET_NOT_CONFIGURED while it is unset.
AUTH_SIGNING_SECRET=
